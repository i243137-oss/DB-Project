<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Disaster MIS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- SIDEBAR -->
        <div class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <i class="fas fa-shield-halved"></i>
                <span>Disaster MIS</span>
            </div>
            <nav class="sidebar-nav">
                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link">
                    <i class="fas fa-chart-pie"></i><span>Dashboard</span>
                </a>
                @if (User.IsInRole("Administrator") || User.IsInRole("Emergency Operator") || User.IsInRole("Field Officer"))
                {
                    <a asp-controller="Emergency" asp-action="Index" class="sidebar-link">
                        <i class="fas fa-triangle-exclamation"></i><span>Emergencies</span>
                    </a>
                }
                @if (User.IsInRole("Administrator") || User.IsInRole("Emergency Operator") || User.IsInRole("Field Officer"))
                {
                    <a asp-controller="RescueTeam" asp-action="Index" class="sidebar-link">
                        <i class="fas fa-people-group"></i><span>Rescue Teams</span>
                    </a>
                }
                @if (User.IsInRole("Administrator") || User.IsInRole("Warehouse Manager"))
                {
                    <a asp-controller="Resource" asp-action="Index" class="sidebar-link">
                        <i class="fas fa-cubes"></i><span>Resources</span>
                    </a>
                }
                @if (User.IsInRole("Administrator") || User.IsInRole("Emergency Operator") || User.IsInRole("Field Officer"))
                {
                    <a asp-controller="Hospital" asp-action="Index" class="sidebar-link">
                        <i class="fas fa-hospital"></i><span>Hospitals</span>
                    </a>
                }
                @if (User.IsInRole("Administrator") || User.IsInRole("Finance Officer"))
                {
                    <a asp-controller="Finance" asp-action="Index" class="sidebar-link">
                        <i class="fas fa-coins"></i><span>Finance</span>
                    </a>
                }
                @if (User.IsInRole("Administrator"))
                {
                    <a asp-controller="Approval" asp-action="Index" class="sidebar-link">
                        <i class="fas fa-clipboard-check"></i><span>Approvals</span>
                    </a>
                    <a asp-controller="Audit" asp-action="Index" class="sidebar-link">
                        <i class="fas fa-file-shield"></i><span>Audit Logs</span>
                    </a>
                }
            </nav>
            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <i class="fas fa-user-circle fa-lg"></i>
                    <div>
                        <small class="d-block fw-semibold">@User.Identity.Name</small>
                        <small class="text-muted">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</small>
                    </div>
                </div>
                <a asp-controller="Account" asp-action="Logout" class="btn btn-sm btn-outline-light w-100 mt-2">
                    <i class="fas fa-right-from-bracket"></i> Logout
                </a>
            </div>
        </div>

        <!-- MAIN CONTENT -->
        <div class="main-content">
            <div class="topbar">
                <button class="btn btn-link sidebar-toggle d-md-none" onclick="document.getElementById('sidebar').classList.toggle('show')">
                    <i class="fas fa-bars fa-lg"></i>
                </button>
                <h5 class="mb-0 topbar-title">@ViewData["Title"]</h5>
                <div class="topbar-right">
                    <span class="badge bg-success"><i class="fas fa-circle fa-xs"></i> Online</span>
                </div>
            </div>
            <div class="content-wrapper">
                @RenderBody()
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
