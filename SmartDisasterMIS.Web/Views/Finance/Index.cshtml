@model IEnumerable<SmartDisasterMIS.Web.Models.Donation>
@{
    ViewData["Title"] = "Finance";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="fas fa-coins me-2 text-primary"></i>Finance Management</h4>
    <div class="d-flex gap-2">
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#donationModal"><i class="fas fa-plus me-1"></i> Record Donation</button>
        <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#expenseModal"><i class="fas fa-plus me-1"></i> Record Expense</button>
    </div>
</div>

<!-- Budget Summary -->
<div class="card mb-4">
    <div class="card-header bg-white"><i class="fas fa-scale-balanced me-1"></i> Event Budget Summary</div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover mb-0">
            <thead><tr><th>Event</th><th>Status</th><th>Donations</th><th>Expenses</th><th>Balance</th></tr></thead>
            <tbody>
            @foreach (var b in ViewBag.BudgetSummary)
            {
                <tr>
                    <td class="fw-semibold">@b.EventName</td>
                    <td><span class="badge bg-info">@b.EventStatus</span></td>
                    <td class="text-success fw-bold">PKR @b.TotalDonation?.ToString("N0")</td>
                    <td class="text-danger fw-bold">PKR @b.TotalExpense?.ToString("N0")</td>
                    <td class="fw-bold">PKR @b.BudgetBalance?.ToString("N0")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="row g-3">
    <!-- Donations -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white"><i class="fas fa-hand-holding-heart me-1 text-success"></i> Donations</div>
            <div class="card-body table-responsive p-0" style="max-height:400px;overflow-y:auto">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Donor</th><th>Event</th><th>Amount</th><th>Method</th><th>Date</th></tr></thead>
                    <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td>@d.Donor?.DonorName</td>
                            <td>@(d.DisasterEvent?.EventName ?? "General")</td>
                            <td class="text-success fw-bold">PKR @d.Amount.ToString("N0")</td>
                            <td><span class="badge bg-light text-dark">@d.PaymentMethod</span></td>
                            <td>@d.DonationDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Expenses -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white"><i class="fas fa-receipt me-1 text-danger"></i> Expenses</div>
            <div class="card-body table-responsive p-0" style="max-height:400px;overflow-y:auto">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Category</th><th>Event</th><th>Amount</th><th>By</th><th>Date</th></tr></thead>
                    <tbody>
                    @foreach (var e in ViewBag.Expenses)
                    {
                        <tr>
                            <td>@e.Category?.CategoryName</td>
                            <td>@(e.DisasterEvent?.EventName ?? "General")</td>
                            <td class="text-danger fw-bold">PKR @e.Amount.ToString("N0")</td>
                            <td>@e.ApprovedByNavigation?.FullName</td>
                            <td>@e.ExpenseDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Record Donation Modal -->
<div class="modal fade" id="donationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white"><h5 class="modal-title"><i class="fas fa-hand-holding-heart"></i> Record Donation</h5></div>
            <form asp-action="RecordDonation" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Donor</label>
                        <select name="donorId" class="form-select" required>
                            @foreach (var d in ViewBag.Donors)
                            {
                                <option value="@d.DonorId">@d.DonorName (@d.DonorType)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Disaster Event (Optional)</label>
                        <select name="disasterEventId" class="form-select">
                            <option value="">-- General Fund --</option>
                            @foreach (var e in ViewBag.Events)
                            {
                                <option value="@e.DisasterEventId">@e.EventName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Amount (PKR)</label>
                        <input type="number" name="amount" class="form-control" min="1" step="0.01" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Payment Method</label>
                        <select name="paymentMethod" class="form-select" required>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Cash">Cash</option>
                            <option value="Cheque">Cheque</option>
                            <option value="Online">Online</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-success w-100"><i class="fas fa-check"></i> Record Donation</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Record Expense Modal -->
<div class="modal fade" id="expenseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white"><h5 class="modal-title"><i class="fas fa-receipt"></i> Record Expense</h5></div>
            <form asp-action="RecordExpense" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select name="categoryId" class="form-select" required>
                            @foreach (var c in ViewBag.Categories)
                            {
                                <option value="@c.CategoryId">@c.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Disaster Event (Optional)</label>
                        <select name="disasterEventId" class="form-select">
                            <option value="">-- General --</option>
                            @foreach (var e in ViewBag.Events)
                            {
                                <option value="@e.DisasterEventId">@e.EventName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Amount (PKR)</label>
                        <input type="number" name="amount" class="form-control" min="1" step="0.01" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="2" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger w-100"><i class="fas fa-check"></i> Record Expense</button>
                </div>
            </form>
        </div>
    </div>
</div>
